{
  "name": "@puzzel/streaming-lib",
  "version": "2.0.0",
  "description": "Streaming library for PCC Chat (new)",
  "license": "MIT",
  "main": "./dist/streaming-lib.cjs",
  "module": "./dist/streaming-lib.mjs",
  "types": "./dist/streaming-lib.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/streaming-lib.d.mts",
        "default": "./dist/streaming-lib.mjs"
      },
      "require": {
        "types": "./dist/streaming-lib.d.cts",
        "default": "./dist/streaming-lib.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/streaming-lib.d.mts",
        "default": "./dist/streaming-lib.js"
      }
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/signalr": "^6.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@microsoft/signalr": ">=6.0.0"
  }
}
